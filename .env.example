# Local development: one file shared by both apps and packages/db.

# Matches docker-compose.yml.
DATABASE_URL=postgres://postgres@localhost:5434/sanitation

# Production sends SMS with SMS_PROVIDER=sender.ge and SENDER_GE_API_KEY.
# Outside production SMS are only logged to the console, even if these are set.
SMS_PROVIDER=
SENDER_GE_API_KEY=

# Public origin of the Client app, used in Manage Links and Booking Links.
APP_URL=http://localhost:3000
