{
  "name": "sanitation-booking-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:app": "turbo dev --filter=@sanitation/app",
    "dev:admin": "turbo dev --filter=@sanitation/admin",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "turbo-env:check": "node scripts/check-turbo-env.mts",
    "risk-tier": "node scripts/risk-tier.mts",
    "db:generate": "pnpm --filter @sanitation/db generate",
    "db:migrate": "pnpm --filter @sanitation/db migrate",
    "db:seed": "pnpm --filter @sanitation/db seed",
    "db:reset": "pnpm --filter @sanitation/db reset",
    "company": "pnpm --filter @sanitation/core company"
  },
  "devDependencies": {
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "turbo": "^2.9.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.4.0"
}
